# ScholarAI Server Configuration
PORT=5000
NODE_ENV=development

# Optional Allowed Origins for CORS (comma-separated, defaults to allowing onrender.com and localhost)
ALLOWED_ORIGINS=

# Optional LLM Configuration (Application runs full deterministic multi-agent pipeline if left unset)
# Supported providers: GEMINI, OPENAI, GROQ
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

